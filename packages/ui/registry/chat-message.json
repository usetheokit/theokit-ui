{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "chat-message",
  "type": "registry:ui",
  "title": "ChatMessage",
  "description": "Composable chat-turn surface with Vercel AI SDK UIMessage parts API \u2014 markdown, code blocks, math, tool calls, reasoning, file attachments, source citations, branching navigation.",
