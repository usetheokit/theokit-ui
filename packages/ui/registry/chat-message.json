    "lucide-react",
    "hast",
    "mdast",
    "@usetheo/ui"
  ],
  "registryDependencies": [
    "chat-types",
    "cn",
    "safe-href",
    "https://usetheodev.github.io/usetheo-ui/r/button.json",
    "agent-tool-renderer",
    "tailwind-preset"
  ],
