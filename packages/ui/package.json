  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json && tsx scripts/inject-use-client.ts && tsx scripts/regen-subpath-exports.ts",
    "dev": "ladle serve",
    "ladle:build": "ladle build",
    "ladle:preview": "ladle preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "validate:naming": "ls-lint",
    "inventory": "node scripts/inventory-components.mjs",
    "stories:check": "node scripts/generate-missing-stories.mjs --check",
    "stories:generate": "node scripts/generate-missing-stories.mjs --write",
    "stories:test": "node scripts/__tests__/generate-missing-stories.test.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:contract": "THEOKIT_REQUIRE_DIST=1 vitest run tests/contract tests/rsc-smoke tests/types",
    "dev:pack": "pnpm build && pnpm pack --pack-destination dist/",
    "prepublishOnly": "pnpm check:release-version && pnpm build && pnpm test:contract && node scripts/validate-exports.mjs && pnpm validate:packaged",
    "validate:exports": "node scripts/validate-exports.mjs",
    "validate:packaged": "tsx scripts/validate-packaged-imports.ts",
    "check:release-version": "tsx scripts/check-release-version.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/build-registry.ts --check",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "sync:readme": "tsx scripts/sync-readme.ts",
    "sync:exports": "tsx scripts/sync-exports.ts",
    "test:registry": "tsx scripts/test-registry-install.ts",
    "test:coverage": "vitest run --coverage",
    "quality:structure": "tsx scripts/validate-quality-gates.ts",
    "classify:check": "tsx scripts/classify-components.ts",
    "quality:bundle": "tsx scripts/validate-bundle-size.ts",
    "quality:bundle:update": "tsx scripts/validate-bundle-size.ts --update",
    "quality:a11y": "vitest run src/test/ladle-axe.test.tsx",
    "quality:visual": "playwright test",
    "quality:visual:update": "playwright test --update-snapshots",
    "quality:contrast": "tsx scripts/validate-contrast.ts",
    "quality:contrast:update": "tsx scripts/validate-contrast.ts --update",
    "dogfood:whiteboard": "tsx scripts/dogfood-whiteboard.ts",
    "dogfood:slide": "tsx scripts/dogfood-slide.ts",
    "dogfood:slide-deck": "tsx scripts/dogfood-slide-deck.ts",
    "dogfood:slide-rich": "tsx scripts/dogfood-slide-rich.ts",
    "dogfood:v4-zero-config": "tsx scripts/dogfood-v4-zero-config.ts",
    "dogfood:precompiled-utilities": "tsx scripts/dogfood-precompiled-utilities.ts",
    "quality:gates": "pnpm format:check && pnpm lint:ci && pnpm validate:naming && pnpm typecheck && pnpm quality:knip && pnpm test && pnpm build && pnpm test:contract && pnpm validate:packaged && pnpm quality:publint && pnpm registry:check && pnpm registry:validate && pnpm quality:structure && pnpm classify:check && pnpm quality:bundle && pnpm quality:contrast && pnpm quality:a11y && pnpm quality:visual && pnpm ladle:build && pnpm dogfood:whiteboard && pnpm dogfood:slide && pnpm dogfood:slide-deck && pnpm dogfood:slide-rich && pnpm dogfood:v4-zero-config && pnpm dogfood:precompiled-utilities",
    "quality:gates:fast": "pnpm format:check && pnpm lint:ci && pnpm validate:naming && pnpm typecheck && pnpm quality:knip && pnpm registry:check && pnpm registry:validate && pnpm quality:structure && pnpm quality:contrast",
    "quality:knip": "knip",
    "quality:knip:fix": "knip --fix",
    "quality:publint": "publint --strict",
    "quality:attw": "attw --pack . --profile esm-only",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
